# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and is only used for local development.

# MongoDB connection string (Atlas or local), e.g.:
# mongodb+srv://user:password@cluster.mongodb.net/sathi
MONGODB_URI=

# Google Gemini API key from https://aistudio.google.com/apikey
# NOTE: no EXPO_PUBLIC_ prefix — this must stay server-only and is only
# read inside src/app/api/**/+api.ts route handlers.
GEMINI_API_KEY=

# Resend (https://resend.com/api-keys) — used to send verification &
# password-reset emails.
RESEND_API_KEY=
# "From" address. Resend's sandbox address (onboarding@resend.dev) works
# without any domain setup, but can only deliver to the email on your Resend
# account. Verify a domain in Resend and use your own address for real users.
RESEND_FROM_EMAIL=Sathi <onboarding@resend.dev>

# Random secret used to sign session tokens (HMAC-SHA256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=
